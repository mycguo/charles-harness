# Add this entry to the ignored checkout .env, or export it to the DSH process.
# Keep .env owner-only (chmod 600); never commit the actual token.
# Create an Atlassian MCP V2 token with only Jira read and search agent-interface scopes.
JIRA_MYCGUO_TOKEN=

# Optional hosted MCP work connection, only when the organization permits it:
# use --server-name jira_kareo --token-env JIRA_TEBRA_TOKEN.
JIRA_TEBRA_TOKEN=

# Recommended jira-kareo REST read tools: use a Jira REST token, not MCP-only scopes.
# Values remain in the private .env; the profile stores only these variable names.
ATLASSIAN_ACCOUNT_EMAIL=
ATLASSIAN_API_TOKEN=

# Optional Jira command Source: a SEPARATE Jira REST API token that can read issues/comments,
# read the current user and create comments, including comment properties. See docs/014-jira-source.md.
# The MCP read/search agent-interface token above cannot perform these REST operations.
JIRA_SUPERAGENT_TOKEN=
